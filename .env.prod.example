# ============================================
# Clinova Penthus AI Engine - Production Environment Template
# Copy this file to .env and update values for production
# ============================================

# Application
APP_NAME=Penthus-Clinical-AI-Engine
APP_VERSION=1.2.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_RELOAD=false
CORS_ORIGINS=["*"]

# Security - CHANGE THESE IN PRODUCTION
SECRET_KEY=generate-a-secure-32-byte-random-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_KEY_HEADER=X-API-Key

# Database (PostgreSQL) - Internal Docker network
DB_PASSWORD=generate-a-secure-database-password-here
DATABASE_URL=postgresql+asyncpg://penthus:${DB_PASSWORD}@postgres:5432/clinova
SYNC_DATABASE_URL=postgresql://penthus:${DB_PASSWORD}@postgres:5432/clinova

# Redis - Internal Docker network
REDIS_URL=redis://redis:6379/0

# vLLM / Model - Internal Docker network
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL=penthus-1.2-alpha-4b
VLLM_TIMEOUT_SECONDS=120
VLLM_MAX_RETRIES=3
HF_TOKEN=your-huggingface-token-here

# OCR Configuration
OCR_CACHE_TTL_SECONDS=2592000
OCR_FORCE_RERUN=false

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PHI_MASKING=true

# Feature Flags
ENABLE_SNOMED_ENDPOINT=true
ENABLE_ICD_ENDPOINT=true
ENABLE_FHIR_ENDPOINT=true
ENABLE_GAP_DETECTION=true
ENABLE_TRANSLATION=true

# Object Storage (Optional - MinIO for local, OCI for production)
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=clinova-documents
OBJECT_STORAGE_SECURE=false

# FHIR Configuration
FHIR_VALIDATION_ENABLED=true
FHIR_BASE_URL=http://localhost:8080/fhir

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10
