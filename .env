# ============================================
# Clinova Penthus AI Engine - Environment
# ============================================

# Application
APP_NAME=Penthus-Clinical-AI-Engine
APP_VERSION=1.2.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
CORS_ORIGINS=["*"]

# Security
SECRET_KEY=Z6q4-9xvYpK8n3s1Vf4e7uGmR2tQwS5bHjL0aNfPcR8yUoXv
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_KEY_HEADER=X-API-Key

# vLLM / Model
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL=penthus-1.2-alpha-4b
VLLM_TIMEOUT_SECONDS=120
VLLM_MAX_RETRIES=3
HF_TOKEN=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

# OCR
OCR_CACHE_TTL_SECONDS=2592000
OCR_FORCE_RERUN=false

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://penthus:${DB_PASSWORD}@postgres:5432/clinova
SYNC_DATABASE_URL=postgresql://penthus:${DB_PASSWORD}@postgres:5432/clinova

# Redis
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# Object Storage (optional - MinIO for local, OCI for production)
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=${OBJECT_STORAGE_ACCESS_KEY}
OBJECT_STORAGE_SECRET_KEY=${OBJECT_STORAGE_SECRET_KEY}
OBJECT_STORAGE_BUCKET=clinova-documents
OBJECT_STORAGE_SECURE=false

# FHIR Configuration
FHIR_VALIDATION_ENABLED=true
FHIR_BASE_URL=http://localhost:8080/fhir

# Audit
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PHI_MASKING=true

# Feature Flags
ENABLE_SNOMED_ENDPOINT=true
ENABLE_ICD_ENDPOINT=true
ENABLE_FHIR_ENDPOINT=true
ENABLE_GAP_DETECTION=true
ENABLE_TRANSLATION=true

# Production secrets (replace placeholders below with generated values)
DB_PASSWORD=7f3c9d2e8a1b4f6c5d2e9a0b8c7d6e4f
REDIS_PASSWORD=R3d1sP@ssw0rd_8yF2qLz9m
OBJECT_STORAGE_ACCESS_KEY=clinova-access-3v9k2
OBJECT_STORAGE_SECRET_KEY=5c3b9e8f1a2d4c6b7f0e9a3d2c1b8e7f6a4b3c2d