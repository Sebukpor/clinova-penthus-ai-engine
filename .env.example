# ============================================
# Clinova Penthus AI Engine - Environment
# ============================================

# Application
APP_NAME=Penthus-Clinical-AI-Engine
APP_VERSION=1.2.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Security
SECRET_KEY=change-me-in-production-use-oci-vault
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_KEY_HEADER=X-API-Key

# vLLM / Model
VLLM_BASE_URL=http://penthus-vllm:8000/v1
VLLM_MODEL=penthus-1.2-alpha-4b
VLLM_TIMEOUT_SECONDS=120
VLLM_MAX_RETRIES=3
VLLM_RETRY_DELAY_SECONDS=2
VLLM_API_KEY=
HF_TOKEN=change-me-use-oci-vault

# OCR
OCR_CACHE_TTL_SECONDS=2592000
OCR_FORCE_RERUN=false

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://penthus:changeme@postgres:5432/clinova
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# Sync Database URL for Alembic
SYNC_DATABASE_URL=postgresql://penthus:changeme@postgres:5432/clinova

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=20
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_HEALTH_CHECK_INTERVAL=30

# Object Storage (OCI Object Storage / MinIO)
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_REGION=us-ashburn-1
OBJECT_STORAGE_BUCKET=clinova-documents
OBJECT_STORAGE_SECURE=false

# Terminology Gateway
TERMINOLOGY_GATEWAY_URL=http://terminology-gateway:8080
TERMINOLOGY_GATEWAY_TIMEOUT_SECONDS=10
TERMINOLOGY_GATEWAY_MAX_RETRIES=2
TERMINOLOGY_CACHE_TTL_SECONDS=604800

# FHIR
FHIR_BASE_URL=http://fhir-server:8080/fhir
FHIR_VALIDATION_ENABLED=true
FHIR_R4_PROFILE_URL=http://hl7.org/fhir/StructureDefinition/

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=penthus-ai-engine
OTEL_SERVICE_VERSION=1.2.0
OTEL_EXPORTER_OTLP_INSECURE=true
PROMETHEUS_PORT=9090
METRICS_ENABLED=true

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Audit
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PHI_MASKING=true

# Feature Flags
ENABLE_SNOMED_ENDPOINT=true
ENABLE_ICD_ENDPOINT=true
ENABLE_FHIR_ENDPOINT=true
ENABLE_GAP_DETECTION=true
ENABLE_TRANSLATION=true

# OCI (Production)
OCI_TENANCY_OCID=
OCI_REGION=us-ashburn-1
OCI_COMPARTMENT_OCID=
OCI_VAULT_OCID=
OCI_OBJECT_STORAGE_NAMESPACE=
